<Project>
  <PropertyGroup>
    <!--
      Path to your local Valheim install (the folder containing valheim.exe and
      valheim_Data\Managed\...dll). Used to reference game and Unity assemblies
      via HintPath — they are never committed to the repo.
    -->
    <VALHEIM_INSTALL>C:\Path\To\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>

    <!--
      Path to the folder containing your installed Jotunn.dll (e.g. an r2modman
      profile's BepInEx\plugins\ValheimModding-Jotunn folder). This is a HintPath
      reference, not a PackageReference, because JotunnLib 2.30.0 on nuget.org
      ships lib/net462 only — no netstandard2.0/2.1 asset — so a netstandard2.1
      project restores it with zero usable references and no warning. Pointing
      at an installed copy of the DLL sidesteps that dead end entirely.
    -->
    <JOTUNN_INSTALL>C:\Path\To\r2modmanPlus-local\Valheim\profiles\dev\BepInEx\plugins\ValheimModding-Jotunn</JOTUNN_INSTALL>
  </PropertyGroup>
</Project>
